package vendor.waydroid.task@1.1;

import @1.0::IWaydroidTask;

interface IWaydroidTask extends @1.0::IWaydroidTask {
    struct TouchPoint {
        int32_t id;
        float x;
        float y;
        float pressure;
    };

    /**
     * Deliver a touch event to the Android task a host window shows,
     * whatever Android's focus and z-order say. action is a MotionEvent
     * action, coordinates are display pixels, times CLOCK_MONOTONIC ns.
     * Returns false when the task has no input window yet or Android
     * refused the event; the caller then uses the shared touchscreen.
     */
    injectTaskTouch(uint32_t taskID, int32_t action, int64_t downTime, int64_t eventTime,
                    vec<TouchPoint> pointers) generates (bool delivered);

    /**
     * Send device key events to the window of this task, the one the host
     * keyboard is on, instead of Android's focused window. 0 goes back to
     * Android's focus. Takes effect for keys written after it returns.
     */
    setKeyTarget(uint32_t taskID);
};
