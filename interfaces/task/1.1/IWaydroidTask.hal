package vendor.waydroid.task@1.1;

import vendor.waydroid.task@1.0;

interface IWaydroidTask extends @1.0::IWaydroidTask {
    /**
     * Runs Android at a monitor's refresh rate, in mHz, by setting its min and peak refresh
     * rate settings. The composer calls it with the fastest monitor that shows a window.
     */
    oneway setRefreshRate(uint32_t millihertz);
};
